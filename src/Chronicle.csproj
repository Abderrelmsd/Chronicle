<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RepositoryUrl>https://github.com/Abderrelmsd/Chronicle</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Abderrelmsd/Chronicle</PackageProjectUrl>
    <PackageId>Chronicle</PackageId>
    <Description>Immutable, tamper-evident audit and history layer: hash-chained entries, PII crypto-shredding, archive-only retention, pluggable store.</Description>
    <RootNamespace>Chronicle</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.12" />
    <PackageReference Include="Bedrock" Version="0.1.0" />
    <PackageReference Include="Cipher" Version="0.1.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Chronicle.Tests" />
  </ItemGroup>
</Project>
